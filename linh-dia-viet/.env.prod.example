# Mẫu .env cho máy chủ production (đặt tên .env trong /opt/linh-dia-viet). deploy.sh tự sinh bí mật lần đầu.
ENV=prod
SECRET_KEY=doi-thanh-chuoi-ngau-nhien-dai
# SQLite mặc định; Postgres: postgresql+psycopg://user:pass@host:5432/linhdia
# DATABASE_URL=sqlite:///./data/linhdia.db
APP_PREFIX=/le-chua
PUBLIC_BASE_URL=https://tuandv.id.vn
SESSION_HTTPS_ONLY=true
HOME_URL=/kinhdich/van-khan
HOME_LABEL="Kinh Dịch"

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=doi-mat-khau-admin

AUTO_APPROVE_RECORDINGS=true
MIN_LEAD_SECONDS=120

# TTS: edge | google | fpt | fake
TTS_PROVIDER=edge
TTS_VOICE=vi-VN-HoaiMyNeural
GOOGLE_TTS_API_KEY=
FPT_TTS_API_KEY=

# MQTT
DEVICE_BUS=mqtt
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=ld-server
MQTT_PASSWORD=doi-mat-khau-mqtt
MQTT_TLS=false
DISPATCH_LEAD_SECONDS=600

# Thiết bị demo được seed (token này cũng là mật khẩu MQTT của thiết bị)
DEMO_DEVICE_ID=pi-demo-01
DEMO_DEVICE_TOKEN=doi-token-thiet-bi

# Production
LD_API_BIND=127.0.0.1:8040
LD_MQTT_BIND=127.0.0.1:1883
LD_DOMAIN=tuandv.id.vn
