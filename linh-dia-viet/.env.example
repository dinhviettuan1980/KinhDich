# Sao chép thành .env rồi đổi các giá trị bí mật. KHÔNG commit .env.
ENV=dev
SECRET_KEY=doi-thanh-chuoi-ngau-nhien-dai
# SQLite mặc định; Postgres: postgresql+psycopg://user:pass@host:5432/linhdia
# DATABASE_URL=sqlite:///./data/linhdia.db
APP_PREFIX=/le-chua
PUBLIC_BASE_URL=http://localhost:8000
SESSION_HTTPS_ONLY=false
HOME_URL=
HOME_LABEL="Kinh Dịch"

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=doi-mat-khau-admin

AUTO_APPROVE_RECORDINGS=true
MIN_LEAD_SECONDS=120

# TTS: edge | google | fpt | fake
TTS_PROVIDER=edge
# Nhận diện mâm lễ (đếm lễ vật trên ảnh camera) qua HF Space OCR miễn phí: hfspace | off
RECOGNITION_PROVIDER=hfspace
RECOGNITION_URL=https://tuandv80-ocr-numbers.hf.space
TTS_VOICE=vi-VN-HoaiMyNeural
GOOGLE_TTS_API_KEY=
FPT_TTS_API_KEY=

# MQTT
DEVICE_BUS=mqtt
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=ld-server
MQTT_PASSWORD=doi-mat-khau-mqtt
MQTT_TLS=false
DISPATCH_LEAD_SECONDS=600

# Thiết bị demo được seed (token này cũng là mật khẩu MQTT của thiết bị)
DEMO_DEVICE_ID=pi-demo-01
DEMO_DEVICE_TOKEN=doi-token-thiet-bi

# Cảnh báo thiết bị mất kết nối khi sắp có lễ (tuỳ chọn gửi Telegram)
ALERT_LEAD_MINUTES=60
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
