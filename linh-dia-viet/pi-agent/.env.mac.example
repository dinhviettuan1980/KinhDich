# Pi giả trên máy tính — phát thật ra loa (ffplay), ảnh mâm lễ giả lập.
LD_SERVER_URL=https://tuandv.id.vn/le-chua
LD_DEVICE_ID=pi-demo-01
LD_DEVICE_TOKEN=
LD_MQTT_HOST=tuandv.id.vn
LD_MQTT_PORT=8883
LD_MQTT_TLS=true
LD_DATA_DIR=~/.linh-dia-viet-pi/data
LD_PLAYER=ffplay
LD_CAMERA=simulate
LD_VOLUME_MAX=100
LD_VOLUME_DEFAULT=80
# Máy tính thì không cần giờ cấm phát
LD_QUIET_START=00:00
LD_QUIET_END=00:00
