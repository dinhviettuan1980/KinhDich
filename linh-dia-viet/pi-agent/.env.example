# /etc/linh-dia-viet/agent.env — cấu hình agent trên Raspberry Pi (chmod 600, KHÔNG chia sẻ token).
# Địa chỉ API, gồm cả tiền tố APP_PREFIX của server
LD_SERVER_URL=https://tuandv.id.vn/le-chua
LD_DEVICE_ID=pi-demo-01
LD_DEVICE_TOKEN=
LD_MQTT_HOST=tuandv.id.vn
LD_MQTT_PORT=8883
LD_MQTT_TLS=true

LD_DATA_DIR=/var/lib/linh-dia-viet

# Âm thanh: mpv | ffplay | aplay. Xem `aplay -l` để chọn thiết bị.
LD_PLAYER=mpv
# mpv: alsa/plughw:CARD=Headphones,DEV=0 ; aplay: plughw:1,0 ; để trống = mặc định
# loa Bluetooth (bluetooth/bt-pair.sh tự ghi): alsa/bluealsa:DEV=AA:BB:CC:DD:EE:FF,PROFILE=a2dp
# chưa có loa (Pi Zero không có jack 3.5 mm, HDMI không cắm màn hình sẽ lỗi): alsa/null — phát câm để chạy thử trọn luồng
LD_AUDIO_DEVICE=
# Trần âm lượng cứng (0–100). Server gửi cao hơn cũng bị cắt về mức này.
LD_VOLUME_MAX=85
LD_VOLUME_DEFAULT=70
# Giờ cấm phát (giờ địa phương). Đặt 2 giá trị bằng nhau để tắt.
LD_QUIET_START=22:00
LD_QUIET_END=05:00
LD_TIMEZONE=Asia/Ho_Chi_Minh

# Camera: rpicam (CSI, Bookworm) | picamera2 | fswebcam (USB) | ffmpeg (USB, v4l2) | none
LD_CAMERA=rpicam
LD_CAMERA_DEVICE=/dev/video0

# Video tại đền: quay mâm lễ + tiếng micro webcam lúc đọc sớ (cần fswebcam/ffmpeg, hoặc simulate = video giả)
LD_RECORD=true
# micro: auto = card USB đầu tiên có thu âm; hoặc vd plughw:CARD=Camera,DEV=0 (xem `arecord -l`)
LD_AUDIO_IN=auto
LD_VIDEO_SIZE=1280x720
LD_VIDEO_FPS=10
LD_RECORD_MAX_SECONDS=300

# Quá giờ hẹn bao nhiêu giây thì không phát nữa (mất điện lâu)
LD_MAX_LATE_SECONDS=600
LD_SIMULATE=false
