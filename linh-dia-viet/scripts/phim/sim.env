# Server GIẢ LẬP chỉ chạy cục bộ để quay phim (giá trị dưới đây là giá trị demo, không dùng cho máy thật).
# Đường dẫn tính từ thư mục server/ (uvicorn và prep.py chạy ở đó).
APP_ENV_FILE=
ENV=dev
SECRET_KEY=sim-secret-local-only
DATABASE_URL=sqlite:///../scripts/phim/data/sim.db
DATA_DIR=../scripts/phim/data
PUBLIC_BASE_URL=http://127.0.0.1:8100
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-demo-123
DEMO_STAFF_PASSWORD=demo12345
DEMO_DEVICE_TOKEN=sim-pi-token
DEVICE_BUS=memory
RECOGNITION_PROVIDER=hfspace
RECOGNITION_URL=http://127.0.0.1:8199
AUTO_APPROVE_RECORDINGS=false
MIN_LEAD_SECONDS=60
CAPTURE_BEFORE_S=20
CAPTURE_AFTER_S=4
SCHEDULER_INTERVAL_SECONDS=3
# GOOGLE_MAPS_API_KEY: KHÔNG ghi vào đây — xem README (lấy từ .env của linh-dia-viet lúc chạy)
